    "ai": "latest",
    "cheerio": "latest",
    "clsx": "latest",
    "gsap": "^3.15.0",
    "imapflow": "^1.3.2",
    "lucide-react": "latest",
    "mailparser": "^3.9.8",
    "nanoid": "latest",
    "next": "latest",
    "playwright-core": "^1.59.1",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
